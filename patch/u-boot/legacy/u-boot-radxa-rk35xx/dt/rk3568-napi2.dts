/dts-v1/;
#include "rk3568-radxa-cm3i.dtsi"

/ {
	model = "Napi 2 RK3568 board";
	compatible = "nnz,napi-2", "rockchip,rk3568";

	/delete-node/ led-sys;

	chosen {
		stdout-path = "serial2:1500000n8";
		u-boot,spl-boot-order = &sdmmc0, &sdhci;
	};

	leds {
		u-boot,dm-pre-reloc;
		compatible = "gpio-leds";

		work {
			label = "work";
			gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		};
	};

	vcc5v0_host_1: vcc5v0-host-1 {
		u-boot,dm-pre-reloc;
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host_1";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_host_2: vcc5v0-host-2 {
		u-boot,dm-pre-reloc;
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host_2";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		vin-supply = <&vcc5v0_sys>;
	};
};

&gmac0 {
	snps,reset-gpio = <&gpio0 RK_PC5 GPIO_ACTIVE_LOW>;
	tx_delay = <0x38>;
	rx_delay = <0x07>;
	status = "okay";
};

&gmac1 {
	snps,reset-gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
	tx_delay = <0x4c>;
	rx_delay = <0x22>;
	status = "okay";
};

&gpio3 {
	u-boot,dm-pre-reloc;
};

&pmu_io_domains {
	pmuio2-supply = <&vcc3v3_pmu>;
	vccio4-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_3v3>;
};

&rk809 {
	vcc1-supply = <&vcc5v0_sys>;
	vcc2-supply = <&vcc5v0_sys>;
	vcc3-supply = <&vcc5v0_sys>;
	vcc4-supply = <&vcc5v0_sys>;
};

&sdhci {
	non-removable;
	max-frequency = <200000000>;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vcc_1v8>;
};

&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	max-frequency = <150000000>;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
};

&sdmmc1 {
	status = "disabled";
};

&nandc0 {
	status = "disabled";
};

&sfc {
	status = "disabled";
};

&pcie30phy {
	status = "disabled";
};

&pcie3x2 {
	status = "disabled";
};

&u2phy0_host {
	phy-supply = <&vcc5v0_host_2>;
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
};

&combphy1_usq {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&pipe_phy_grf1 {
	u-boot,dm-pre-reloc;
};

&usbhost_dwc3 {
	phys = <&u2phy0_host>, <&combphy1_usq PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
};

&usb2phy1_grf {
	u-boot,dm-pre-reloc;
};

&usb2phy1 {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&u2phy1_otg {
	u-boot,dm-pre-reloc;
	phy-supply = <&vcc5v0_host_1>;
	status = "okay";
};

&u2phy1_host {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&usb_host0_ehci {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&usb_host0_ohci {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&usb_host1_ehci {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&usb_host1_ohci {
	u-boot,dm-pre-reloc;
	status = "okay";
};

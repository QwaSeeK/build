/dts-v1/;

#include "rk3562.dtsi"
#include "rk3562-rk809.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "NapiLab NAPI-M";
	compatible = "napilab,napi-m", "rockchip,rk3562";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		mmc0 = &sdhci;
		mmc1 = &sdmmc0;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc0 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		recovery-key {
			label = "recovery";
			linux,code = <KEY_RESTART>;
			press-threshold-microvolt = <17000>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&status_leds>;

		led-0 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};

		led-1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc3v3_sys: regulator-vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_usb: regulator-vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_host_enable>;
		vin-supply = <&vcc5v0_sys>;
	};
};

&combphy_pu {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&gmac0 {
	phy-mode = "rgmii-id";
	clock_in_out = "output";
	phy-supply = <&vcc_3v3>;
	phy-handle = <&rtl8211f>;
	snps,reset-gpio = <&gpio0 RK_PA1 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&rgmiim0_miim &rgmiim0_tx_bus2 &rgmiim0_rx_bus2
		     &rgmiim0_rgmii_clk &rgmiim0_rgmii_bus &gmac_reset>;
	status = "okay";
};

&gmac1 {
	phy-mode = "rmii";
	clock_in_out = "input";
	phy-supply = <&vcc_3v3>;
	phy-handle = <&rtl8201f>;
	snps,reset-gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&rmii_pins &ethm1_pins &gmac1_reset>;
	status = "okay";
};

&i2c0 {
	clock-frequency = <400000>;
};

&i2c1 {
	status = "okay";
	clock-frequency = <100000>;
};

&i2c2 {
	status = "okay";
	clock-frequency = <100000>;
};

&mdio0 {
	/* The fitted PHYAD resistors select address 1. */
	rtl8211f: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

&mdio1 {
	rtl8201f: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		clocks = <&cru CLK_GMAC_ETH_OUT2IO>;
		assigned-clocks = <&cru CLK_GMAC_ETH_OUT2IO>;
		assigned-clock-rates = <25000000>;
	};
};

&pinctrl {
	ethernet {
		gmac_reset: gmac-reset {
			rockchip,pins = <0 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		gmac1_reset: gmac1-reset {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	leds {
		status_leds: status-leds {
			rockchip,pins = <0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>,
					<0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		usb_host_enable: usb-host-enable {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&rk809 {
	/* R14/R15 set BUCK3 to about 1.21 V through external feedback. */
	/delete-property/ fb-inner-reg-idxs;
	pinctrl-0 = <&pmic_int &soc_slppin_gpio>;
};

/* The RK809 audio interface is tied to ground. */
&rk809_codec {
	status = "disabled";
};

&saradc0 {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	no-sd;
	no-sdio;
	non-removable;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vcc_1v8>;
	mmc-hs200-1_8v;
	status = "okay";
};

&sdmmc0 {
	bus-width = <4>;
	no-mmc;
	no-sdio;
	cap-sd-highspeed;
	max-frequency = <50000000>;
	disable-wp;
	/* J6 has no detect contact; GPIO0_A4 has fixed resistors. */
	broken-cd;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd>;
	status = "okay";
};

&tsadc {
	/* GPIO0_A1 controls PHY reset, so use CRU thermal shutdown. */
	rockchip,hw-tshut-mode = <0>;
	status = "okay";
};

&u2phy {
	status = "okay";
};

&u2phy_host {
	phy-supply = <&vcc5v0_sys>;
	status = "okay";
};

&u2phy_otg {
	phy-supply = <&vcc5v0_usb>;
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usbdrd30 {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "host";
	status = "okay";
};

/* LDO1 and LDO9 feed unused reserve rails. */
&vcc2v8_dvp {
	status = "disabled";
};

&vcc1v8_dvp {
	status = "disabled";
};

/* LDO4 has no consumers on this board. */
&vccio_acodec {
	status = "disabled";
};

&vccio_sd {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};
